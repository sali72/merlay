{
  "name": "obsidian-visual-mermaid",
  "version": "0.1.0",
  "description": "Bidirectional drag-and-drop visual editor for Mermaid diagrams with zero code lock-in and seamless AI round-trip support in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "mermaid",
    "diagram",
    "flowchart",
    "visual-editor",
    "drag-and-drop"
  ],
  "author": "Ali",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sali72/obsidian-visual-mermaid.git"
  },
  "bugs": {
    "url": "https://github.com/sali72/obsidian-visual-mermaid/issues"
  },
  "homepage": "https://github.com/sali72/obsidian-visual-mermaid#readme",
  "dependencies": {
    "@xyflow/react": "^12.4.2",
    "elkjs": "^0.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.23.0",
    "obsidian": "latest",
    "tslib": "^2.6.3",
    "tsx": "^4.23.12",
    "typescript": "^5.5.2"
  }
}
